DATABASE_URL=postgresql://keel:keel@localhost:5433/keel
KEEL_TEST_DATABASE_URL=postgresql://keel:keel@localhost:5433/keel_test
KEEL_DEV_TOKEN=dev-token
KEEL_TEAMMATE_TOKEN=teammate-token

# --- Agent onboarding / identity (I2/I3) ---
# Firebase/Google sign-in for dashboard approval. Unset -> /connect/approve returns 503.
KEEL_FIREBASE_PROJECT_ID=
KEEL_FIREBASE_AUDIENCE=
# Project a first-time Google user is attached to; unset -> unknown emails are refused.
KEEL_DEFAULT_PROJECT_ID=
KEEL_DEVICE_CODE_TTL_SECONDS=600
KEEL_DEVICE_POLL_INTERVAL=5
# Tests only: KEEL_FIREBASE_VERIFIER=fake
